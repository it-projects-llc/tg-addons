<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_already_duplicated_invoices_wizard_form" model="ir.ui.view">
        <field name="name">already.duplicated.invoices.wizard.form</field>
        <field name="model">already.duplicated.invoices.wizard</field>
        <field name="arch" type="xml">
            <form>
                <label for="already_duplicated_invoices" />
                <field name="already_duplicated_invoices" nolabel="1">
                    <tree>
                        <field name="name" />
                        <field name="partner_id" />
                        <field name="amount_total" />
                        <field name="currency_id" column_invisible="1" />
                    </tree>
                </field>
                <footer>
                    <button
                        type="object"
                        class="btn btn-primary"
                        name="action_ignore_and_duplicate"
                        string="Ignore and duplicate others"
                    />
                    <button string="Cancel" class="btn btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
