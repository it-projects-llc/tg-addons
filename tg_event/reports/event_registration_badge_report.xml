<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="report_event_registration_badge_tg25" model="ir.actions.report">
        <field name="name">Registration Badge TG25</field>
        <field name="model">event.registration</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >event.event_registration_report_template_badge_tg25</field>
        <field
            name="report_file"
        >event.event_registration_report_template_badge_tg25</field>
        <field
            name="print_report_name"
        >'Registration Event - %s' % (object.name or 'Attendee').replace('/','')</field>
        <field name="paperformat_id" ref="event.paperformat_euro_lowmargin" />
        <field name="binding_model_id" ref="model_event_registration" />
        <field name="binding_type">report</field>
    </record>

