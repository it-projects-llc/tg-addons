<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_split_payments_form" model="ir.ui.view">
        <field name="name">sale.split.payments.form</field>
        <field name="model">sale.split.payments</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="so" />
                    <field name="deposit" />
                    <field name="min_deposit" />
                    <field name="max_deposit" />
                    <field name="payment_count" />
                    <field name="period" />
                    <field name="currency_id" invisible="1" />
                </group>
                <footer>
                    <button
                        string="Split"
                        class="btn btn-primary"
                        type="object"
                        name="action_split"
                    />
                    <button string="Cancel" class="btn btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_order_action_split_payments" model="ir.actions.act_window">
        <field name="name">Split Payments</field>
        <field name="res_model">sale.split.payments</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
    </record>
</odoo>
