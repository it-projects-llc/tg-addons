<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_invoice_plan" model="ir.actions.report">
        <field name="name">Invoice Plan</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >tg_website_event_sale_split_payments.report_invoice_plan</field>
        <field
            name="report_file"
        >tg_website_event_sale_split_payments.report_invoice_plan</field>
        <field
            name="print_report_name"
        >'Invoice plan for' + ((object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name))</field>
        <field name="binding_model_id" ref="model_sale_order" />
        <field name="binding_type">report</field>
    </record>
</odoo>
