<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="event_registration_view_form" model="ir.ui.view">
        <field name="name">event.registration.form.tg.split.payment</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event_sale.event_registration_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_line_id']" position="after">
                <field name="is_fully_paid" />
            </xpath>
        </field>
    </record>
</odoo>
