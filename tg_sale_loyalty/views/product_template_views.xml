<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.sale.loyalty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="has_related_loyalty_programs" invisible="1" />
                <button
                    class="oe_stat_button"
                    name="action_show_loyalty_programs"
                    invisible="not has_related_loyalty_programs"
                    type="object"
                    icon="fa-percent"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Loyalty Programs</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
