<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tg.pos.splitpayment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_pricing_section']" position="after">
                <block title="Split Payment" id="pos_split_payment_section">
                    <setting id="pos_split_payment" help="Configure how many orders an order can be split into.">
                        <field name="pos_max_split_orders"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
