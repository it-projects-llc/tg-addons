<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_generate_shuttle_ticket_answers_form" model="ir.ui.view">
        <field name="name">generate.shuttle.ticket.answers.form</field>
        <field name="model">generate.shuttle.ticket.answers</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="question" />
                    <field name="events_to_generate_from_domain" invisible="1" />
                    <field
                        name="events_to_generate_from"
                        domain="events_to_generate_from_domain"
                    >
                        <tree>
                            <field name="name" />
                            <field name="date_begin" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        string="Generate"
                        class="btn btn-primary"
                        name="generate"
                        type="object"
                    />
                    <button string="Cancel" class="btn" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
