<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="event_registration_view_form" model="ir.ui.view">
        <field name="name">event.registration.view.form.combo.tickets</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="website_event.event_registration_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="parent_reg_for_shuttle" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shuttle tickets" invisible="not shuttle_regs">
                    <field name="shuttle_regs">
                        <tree>
                            <field name="name" />
                            <field name="event_id" />
                            <field name="event_ticket_id" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
