<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="event_question_view_form" model="ir.ui.view">
        <field name="name">event.question.form.combo.tickets</field>
        <field name="model">event.question</field>
        <field name="inherit_id" ref="website_event.event_question_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='question_type']" position="after">
                <field
                    name="is_shuttle_ticket"
                    invisible="question_type != 'simple_choice'"
                />
                <field
                    name="is_accomodation"
                    invisible="question_type != 'simple_choice'"
                />
                <button
                    name="action_generate_ticket_answers"
                    string="Generate answers"
                    class="btn btn-secondary"
                    type="object"
                    invisible="not is_shuttle_ticket and not is_accomodation"
                />
            </xpath>
            <xpath expr="//field[@name='answer_ids']/tree" position="inside">
                <field
                    name="shuttle_ticket"
                    context="{'name_with_event_name': True}"
                    column_invisible="not parent.is_shuttle_ticket"
                    required="parent.is_shuttle_ticket"
                    domain="shuttle_ticket_domain"
                />
                <field name="shuttle_ticket_domain" column_invisible="1" />
                <field
                    name="is_positive_accomodation_answer"
                    column_invisible="not parent.is_accomodation"
                    required="parent.is_accomodation"
                />
            </xpath>
        </field>
    </record>
</odoo>
