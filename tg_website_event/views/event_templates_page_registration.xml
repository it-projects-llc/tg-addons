<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="event_description_full"
        inherit_id="website_event.event_description_full"
        priority="15"
    >
        <xpath expr="//t[@t-snippet-call='website.s_share']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-call='website_event.event_details']" position="inside">
            <script>
document.addEventListener("DOMContentLoaded", (event) => {
  const btn = document.querySelector('button[data-bs-target="#modal_ticket_registration"]');
  if (btn) btn.click();
});
            </script>
        </xpath>
    </template>
</odoo>
