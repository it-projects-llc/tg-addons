<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_view_form" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.website.tg</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="website_event.event_event_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id'][2]" position="attributes">
                <attribute name="groups" />
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="event_view_tree" model="ir.ui.view">
        <field name="name">event.event.tree.tg</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="open_form_view">True</attribute>
            </tree>
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="website_published" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
