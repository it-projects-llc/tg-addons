<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_rfid.NFCButton">
        <div
            class="btn btn-light rounded-0 fw-bolder"
            t-att-class="{
                         'text-danger': !state.isRunning,
                         'text-success': state.isRunning,
                         'd-none': !isVisible
                         }"
            t-on-click="() => this.click()"
        >
            NFC
        </div>
    </t>

</templates>
