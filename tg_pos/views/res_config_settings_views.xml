<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tg.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_limit_categories']/.." position="after">
                <setting help="If set, products only from this shop will be shown">
                    <field name="pos_shop_ref_id" />
                </setting>
            </xpath>
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <field name="pos_show_auto_duplicate_invoices" invisible="1" />
                <setting
                    help="If set, invoices from orders will be duplicated to fiscal company "
                    invisible="not pos_show_auto_duplicate_invoices"
                >
                    <field name="pos_auto_duplicate_invoices" />
                </setting>
                <setting
                    help="If set, error during fiscal company will be shown in POS"
                    invisible="not pos_show_auto_duplicate_invoices or not pos_auto_duplicate_invoices"
                >
                    <field name="pos_debug_auto_duplicate_invoices" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
