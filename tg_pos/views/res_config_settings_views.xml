<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tg.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_limit_categories']/.." position="after">
                <setting help="If set, products only from this shop will be shown">
                    <field name="pos_shop_ref_id" />
                </setting>
                <setting
                    help="When enabled, shows 'Return Products' button in POS order form"
                >
                    <field name="pos_show_return_products" />
                </setting>
                <setting
                    help="When enabled, shows 'Invoice' button in payment screen of POS"
                >
                    <field name="pos_show_invoice_button" />
                </setting>
            </xpath>
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <field name="pos_show_auto_duplicate_invoices" invisible="1" />
                <setting
                    help="If set, invoices from orders will be duplicated to fiscal company "
                    invisible="not pos_show_auto_duplicate_invoices"
                >
                    <field name="pos_auto_duplicate_invoices" />
                </setting>
                <setting
                    help="If set, error during fiscal company will be shown in POS"
                    invisible="not pos_show_auto_duplicate_invoices or not pos_auto_duplicate_invoices"
                >
                    <field name="pos_debug_auto_duplicate_invoices" />
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_partner_deselection" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.tg.pos.partner.deselection</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="pos_partner_deselection.res_config_settings_view_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='pos_customer_deselection_interval']/.."
                position="before"
            >
                <field
                    name="pos_customer_deselection_interval_readonly"
                    invisible="1"
                />
            </xpath>
            <xpath
                expr="//field[@name='pos_customer_deselection_interval']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >pos_customer_deselection_interval_readonly</attribute>
            </xpath>
        </field>
    </record>
</odoo>
