<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.tg</field>
        <field name="model">pos.order</field>
        <field name="priority" eval="100" />
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='refund']" position="before">
                <field name="show_return_products" invisible="1" />
            </xpath>
            <xpath expr="//button[@name='refund']" position="attributes">
                <attribute
                    name="invisible"
                >not show_return_products or state == 'draft' or not has_refundable_lines</attribute>
            </xpath>
        </field>
    </record>
</odoo>
