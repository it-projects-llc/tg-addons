<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_view_form" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tg.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='available_in_pos']" position="after">
                <field name="shop_ids" invisible="available_in_pos == False" />
            </xpath>
        </field>
    </record>
</odoo>
