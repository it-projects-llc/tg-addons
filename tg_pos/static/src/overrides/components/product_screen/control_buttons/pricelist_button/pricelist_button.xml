<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.SetPricelistButton" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pricelist_button')]" position="attributes">
            <attribute name="t-att-class">
                {'disabled': !pos.user.hasGroupEnablePricelistButton}
            </attribute>
        </xpath>
    </t>

</templates>
