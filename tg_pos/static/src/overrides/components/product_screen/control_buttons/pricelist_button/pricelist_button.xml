<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.SetPricelistButton" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pricelist_button')]" position="attributes">
            <attribute name="t-attf-class">
                control-button o_pricelist_button btn btn-light rounded-0 fw-bolder {{ !pos.user.hasGroupEnablePricelistButton ? 'disabled' : '' }}
            </attribute>
        </xpath>
    </t>

</templates>
