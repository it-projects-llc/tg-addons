<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="PaymentScreenButtons"
        t-inherit="point_of_sale.PaymentScreenButtons"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('partner-button')]" position="attributes">
            <attribute
                name="t-att-disabled"
            >!pos.user.hasGroupShowCustomerButton</attribute>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">pos.config.show_invoice_button</attribute>
        </xpath>
    </t>
</templates>
