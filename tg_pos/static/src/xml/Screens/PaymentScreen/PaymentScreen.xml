<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('customer-button')]/div" position="attributes">
            <attribute name="t-if">env.pos.get_cashier().hasGroupShowCustomerButton</attribute>
        </xpath>
        <xpath expr="//div[hasclass('customer-button')]/div" position="after">
            <div class="button disable" t-if="!env.pos.get_cashier().hasGroupShowCustomerButton">
                <i class="fa fa-user" role="img" aria-label="Customer" title="Customer" />
                <span class="js_customer_name">Customer</span>
            </div>
        </xpath>
    </t>
</templates>
