<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="generate_grouped_invoice_view_form" model="ir.ui.view">
        <field name="name">generate.grouped.invoice.form</field>
        <field name="model">generate.grouped.invoice</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_start" required="1" />
                    <field name="date_end" required="1" />
                    <field name="pos_configs" readonly="1">
                        <tree>
                            <field name="display_name" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        name="generate"
                        string="Generate"
                        type="object"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="generate_grouped_invoice_action" model="ir.actions.act_window">
        <field name="name">Generate grouped invoice</field>
        <field name="res_model">generate.grouped.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_config" />
    </record>
</odoo>
