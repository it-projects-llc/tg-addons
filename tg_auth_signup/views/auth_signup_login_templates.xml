<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="login" inherit_id="auth_signup.login">
        <xpath expr="//a[@t-if='signup_enabled']/.." position="attributes">
            <!-- removed small, mt-2 class and added flex-column -->
            <attribute
                name="class"
            >justify-content-between d-flex flex-column</attribute>
            <attribute name="style">margin-top: -0.2rem !important</attribute>
        </xpath>
        <xpath expr="//a[@t-if='signup_enabled']" position="attributes">
            <!-- hide the original link to avoid position='replace' xpath -->
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//a[@t-if='signup_enabled']" position="after">
            <!-- wrapped the signup link in a button and renamed the signup text -->
            <a
                t-if="signup_enabled"
                t-attf-href="/web/signup?{{ keep_query() }}"
                class="btn btn-secondary mt-2"
            >Create New Account</a>
        </xpath>
        <xpath expr="//a[@t-if='reset_password_enabled']" position="attributes">
            <!-- wrapped the reset password link in a button -->
            <attribute name="class">btn btn-secondary mt-2</attribute>
        </xpath>
    </template>
</odoo>
