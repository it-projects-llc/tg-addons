<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rental_order_view_search" model="ir.ui.view">
        <field name="name">rental.order.search.tg</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_search" />
        <field name="arch" type="xml">
            <searchpanel>
                <field name="payment_status" icon="fa-retweet" enable_counters="1" />
            </searchpanel>
        </field>
    </record>

    <record id="order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.tg.renting</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="payment_status" groups="base.group_no_one" />
            </xpath>
        </field>
    </record>
</odoo>
