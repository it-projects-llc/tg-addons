<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.tg.website.sale.renting</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="website_sale_renting.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@id='sale_renting_product_settings']"
                position="inside"
            >
                <setting company_dependent="1">
                    <field name="renting_default_start_date" />
                </setting>
                <setting company_dependent="1">
                    <field name="renting_default_end_date" />
                </setting>
                <setting company_dependent="1">
                    <field name="renting_min_start_date" />
                </setting>
                <setting company_dependent="1">
                    <field name="renting_max_end_date" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
