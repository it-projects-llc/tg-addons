<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_view_form" model="ir.ui.view">
        <field name="name">product.template.sale.renting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_renting.product_template_form_view_rental" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricing']" position="inside">
                <field name="renting_min_start_date" />
                <field name="renting_max_end_date" />
            </xpath>
        </field>
    </record>
</odoo>
