<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Override for sale portal template -->
    <template id="tg_portal_my_home_sale" inherit_id="sale.portal_my_home_sale">
        <xpath
            expr="//t[@t-call='portal.portal_docs_entry'][2]/t[@t-set='bg_color']"
            position="attributes"
        >
            <attribute name="t-value">'text-bg-light'</attribute>
        </xpath>
    </template>

</odoo>
