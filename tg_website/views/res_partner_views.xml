<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.tg.website</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="website.view_partner_form_inherit_website" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="after">
                <field name="tnc_accepted" />
            </xpath>
        </field>
    </record>
</odoo>
