<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="loyalty_program_view_form" model="ir.ui.view">
        <field name="name">loyalty.program.view.form.tg</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="after">
                <field name="nationality_programs">
                    <tree editable="bottom">
                        <field name="nationality" options="{'no_create': 1}" />
                    </tree>
                </field>
            </xpath>
        </field>
    </record>


</odoo>
